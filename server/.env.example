# Campus Action - Server Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Authentication credential for the AI model provider (e.g. OpenAI API key).
# OPTIONAL: If AI_API_KEY is missing or blank, the server automatically falls
# back to a local, deterministic demo extractor that returns the same
# StructuredResult JSON format. Set a real key to use the live AI provider.
AI_API_KEY=your-ai-api-key-here

# Base URL for the AI model API (e.g. https://api.openai.com/v1).
# Only used when AI_API_KEY is configured.
AI_PROVIDER_ENDPOINT=https://your-ai-provider-endpoint/v1

# Model identifier to use for completions (e.g. gpt-4o).
# Only used when AI_API_KEY is configured.
AI_MODEL_NAME=your-model-name-here

# HTTP port the Express server listens on (default: 3001)
PORT=3001

# Runtime environment: development | production
NODE_ENV=development
